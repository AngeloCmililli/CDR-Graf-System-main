        row.classList.remove('bg-emerald-500/20', 'border-emerald-500/80', 'ring-1', 'ring-emerald-400/50', 'bg-sky-500/20', 'border-sky-500/80', 'ring-1', 'ring-sky-400/50');
        if (check) check.classList.add('hidden');
      }
    });

    // 4. Update Primary KPI Hero Card
    const totalCallsEl = document.getElementById('totalCallsNumber');
    const inboundEl = document.getElementById('inboundNumber');
    const outboundEl = document.getElementById('outboundNumber');
    const inboundPctEl = document.getElementById('inboundPercent');
    const outboundPctEl = document.getElementById('outboundPercent');
    const inboundBar = document.getElementById('inboundBar');
    const outboundBar = document.getElementById('outboundBar');
    const kpiHeroLabel = document.getElementById('kpiHeroLabel');
    const kpiSubtext = document.getElementById('kpiSubtext');

    totalCallsEl.textContent = formatNum(data.totalCalls);
    inboundEl.textContent = formatNum(data.inbound);
    outboundEl.textContent = formatNum(data.outbound);
    inboundPctEl.textContent = `${data.inboundPct}%`;
    outboundPctEl.textContent = `${data.outboundPct}%`;
    inboundBar.style.width = `${data.inboundPct}%`;
    outboundBar.style.width = `${data.outboundPct}%`;

    if (activeFilterType === 'operator') {
      kpiHeroLabel.textContent = `Llamadas Diarias — ${data.name}`;
      kpiSubtext.textContent = `Filtrado por operador: ${data.name} (haz clic para restablecer)`;
    } else if (activeFilterType === 'trunk') {
      kpiHeroLabel.textContent = `Tráfico SIP — ${data.name}`;
      kpiSubtext.textContent = `Troncal ${data.directionLabel} (${data.channels}) • Asterisk VoIP Gateway`;
    } else {
      kpiHeroLabel.textContent = `Total de Llamadas Diarias`;
      kpiSubtext.textContent = `Consolidado general de tráfico en tiempo real`;
    }

    // 5. Update Chart Section
    document.getElementById('chartPeakBadge').textContent = data.peakText;
    document.getElementById('yLabel3').textContent = data.yLabels[0];
    document.getElementById('yLabel2').textContent = data.yLabels[1];
    document.getElementById('yLabel1').textContent = data.yLabels[2];
    document.getElementById('yLabel0').textContent = data.yLabels[3];

    // Compute SVG coordinates dynamically based on hourlyValues & yScaleMax
    updateSvgChart(data);

    // 6. Update Donut Chart & Breakdown
    updateDonutChart(data);
  }

  function updateSvgChart(data) {
    const xCoords = [60, 112, 165, 220, 275, 330, 385, 440, 495];
    const topY = 25; // max visual height
    const baseY = 215; // baseline y
    const availableHeight = baseY - topY;

    // Calculate Y for each point
    const pts = data.hourlyValues.map((v, i) => {
      const ratio = Math.min(1, Math.max(0, v / data.yScaleMax));
      const y = baseY - (ratio * availableHeight);
      return { x: xCoords[i], y: Math.round(y) };
    });

    // Build smooth cubic bezier path
    let lineD = `M ${pts[0].x},${pts[0].y}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i];
      const p1 = pts[i + 1];
      const mx = (p0.x + p1.x) / 2;
      lineD += ` C ${mx},${p0.y} ${mx},${p1.y} ${p1.x},${p1.y}`;
    }
    const areaD = `${lineD} L ${pts[pts.length - 1].x},${baseY} L ${pts[0].x},${baseY} Z`;

    const svgLine = document.getElementById('svgLinePath');
    const svgArea = document.getElementById('svgAreaPath');
    if (svgLine && svgArea) {
      svgLine.setAttribute('d', lineD);
      svgArea.setAttribute('d', areaD);
    }

    // Update circles
    pts.forEach((pt, idx) => {
      const circle = document.getElementById(`pt${idx}`);
      if (circle) {
        circle.setAttribute('cx', pt.x);
        circle.setAttribute('cy', pt.y);
        if (idx === data.peakHourIndex) {
          circle.setAttribute('r', '6.5');
          circle.setAttribute('fill', '#38bdf8');
          circle.classList.add('status-pulse');
        } else {
          circle.setAttribute('r', '4.5');
          circle.setAttribute('fill', '#0284c7');
          circle.classList.remove('status-pulse');
        }
      }
    });

    // Update peak badge tag over the peak point
    const peakIdx = data.peakHourIndex;
    const peakPt = pts[peakIdx];
    const tagGroup = document.getElementById('peakTagGroup');
    const tagText = document.getElementById('peakTagText');
    const tagRect = document.getElementById('peakTagRect');
    if (tagGroup && tagText && tagRect) {
      tagText.textContent = data.peakValText;
      const tagX = Math.max(48, Math.min(440, peakPt.x - 33));
      const tagY = Math.max(2, peakPt.y - 23);
      tagGroup.setAttribute('transform', `translate(${tagX}, ${tagY})`);
    }

    // Update x-axis highlighted label
    const xLabels = document.querySelectorAll('#xAxisLabelsGroup text');
    xLabels.forEach((label, idx) => {
      if (idx === peakIdx) {
        label.setAttribute('fill', '#38bdf8');
        label.setAttribute('font-weight', 'bold');
      } else {
        label.setAttribute('fill', isDarkMode ? '#94a3b8' : '#64748b');
        label.setAttribute('font-weight', 'normal');
      }
    });
  }

  function updateDonutChart(data) {
    const circum = 301.59;
    const st = data.status;

    // Segment lengths
    const lenAns = (st.answered.pct / 100) * circum;
    const lenNo = (st.noAnswer.pct / 100) * circum;
    const lenBusy = (st.busy.pct / 100) * circum;
    const lenFail = (st.failed.pct / 100) * circum;

    // Offsets
    const offAns = 0;
    const offNo = -lenAns;
    const offBusy = -(lenAns + lenNo);
    const offFail = -(lenAns + lenNo + lenBusy);

    const cAns = document.getElementById('donutAnswered');
    const cNo = document.getElementById('donutNoAnswer');
    const cBusy = document.getElementById('donutBusy');
    const cFail = document.getElementById('donutFailed');

    if (cAns) {
      cAns.setAttribute('stroke-dasharray', `${lenAns.toFixed(2)} ${circum}`);
      cAns.setAttribute('stroke-dashoffset', offAns);
    }
    if (cNo) {
      cNo.setAttribute('stroke-dasharray', `${lenNo.toFixed(2)} ${circum}`);
      cNo.setAttribute('stroke-dashoffset', offNo.toFixed(2));
    }
    if (cBusy) {
      cBusy.setAttribute('stroke-dasharray', `${lenBusy.toFixed(2)} ${circum}`);
      cBusy.setAttribute('stroke-dashoffset', offBusy.toFixed(2));
    }
    if (cFail) {
      cFail.setAttribute('stroke-dasharray', `${lenFail.toFixed(2)} ${circum}`);
      cFail.setAttribute('stroke-dashoffset', offFail.toFixed(2));
    }

    // Donut Center Text
    document.getElementById('statusNCount').textContent = `N = ${formatNum(data.totalCalls)}`;
    document.getElementById('donutCenterTotal').textContent = formatNum(data.totalCalls);

    // Breakdown text
    document.getElementById('statusCountAnswered').textContent = `${formatNum(st.answered.count)} llamadas`;
    document.getElementById('statusPctAnswered').textContent = `${st.answered.pct}%`;

    document.getElementById('statusCountNoAnswer').textContent = `${formatNum(st.noAnswer.count)} llamadas`;
    document.getElementById('statusPctNoAnswer').textContent = `${st.noAnswer.pct}%`;

    document.getElementById('statusCountBusy').textContent = `${formatNum(st.busy.count)} llamadas`;
    document.getElementById('statusPctBusy').textContent = `${st.busy.pct}%`;

    document.getElementById('statusCountFailed').textContent = `${formatNum(st.failed.count)} llamadas`;
    document.getElementById('statusPctFailed').textContent = `${st.failed.pct}%`;
  }

  // =================== REFRESH ANIMATION ===================
